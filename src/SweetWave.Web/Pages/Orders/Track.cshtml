@page
@model TrackModel
@{
    ViewData["Title"] = "Отслеживание заказа";
}

<h1 class="h3 mb-3">Отслеживание заказа</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="post" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label" asp-for="Input.Number"></label>
                <input class="form-control" asp-for="Input.Number" placeholder="SW-XXXXXX" />
                <span class="text-danger small" asp-validation-for="Input.Number"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Input.Phone"></label>
                <input class="form-control" asp-for="Input.Phone" placeholder="+7 999 000-11-22" />
                <span class="text-danger small" asp-validation-for="Input.Phone"></span>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Найти заказ</button>
            </div>
        </form>
    </div>
</div>

@if (Model.IsNotFound)
{
    <div class="alert alert-warning">
        Заказ с таким номером и телефоном не найден. Проверьте номер и телефон получателя.
    </div>
}

@if (Model.Order is not null)
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Заказ @Model.Order.Number</h2>
                    <p class="text-secondary small mb-3">
                        Создан @Model.Order.CreatedAtUtc.FormatDateTime() · волна от @Model.Order.WaveShipDate.FormatDate()
                    </p>
                    <partial name="_OrderStatusTimeline" model="Model.Order" />
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Состав</h2>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (OrderLineSummary item in Model.Order.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>@item.ProductName × @item.Quantity</span>
                                <span>@item.LineTotal.FormatPrice()</span>
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-between">
                        <span>Товары</span><span>@Model.Order.GoodsCost.FormatPrice()</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Доставка</span><span>@Model.Order.ShippingCost.FormatPrice()</span>
                    </div>
                    @if (Model.Order.HasThermoPack)
                    {
                        <div class="d-flex justify-content-between">
                            <span>Термоупаковка</span><span>@Model.Order.ThermoPackCost.FormatPrice()</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between border-top mt-2 pt-2">
                        <strong>Итого</strong><strong>@Model.Order.TotalCost.FormatPrice()</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
}