@page
@model LoginModel
@{
    ViewData["Title"] = "Вход для администратора";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4 mb-3">Вход для администратора</h1>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.UserName"></label>
                        <input class="form-control" asp-for="Input.UserName" autocomplete="username" />
                        <span class="text-danger small" asp-validation-for="Input.UserName"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Password"></label>
                        <input class="form-control" asp-for="Input.Password" type="password" autocomplete="current-password" />
                        <span class="text-danger small" asp-validation-for="Input.Password"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Войти</button>
                </form>
            </div>
        </div>
    </div>
</div>