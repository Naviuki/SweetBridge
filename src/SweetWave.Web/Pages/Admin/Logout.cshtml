@page
@model LogoutModel
@{
    ViewData["Title"] = "Выход";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h4">Сеанс администратора завершён</h1>
        <p class="text-secondary">Воспользуйтесь кнопкой «Вход для администратора» в меню, чтобы войти снова.</p>
        <a class="btn btn-primary" asp-page="/Admin/Login">Войти снова</a>
    </div>
</div>