@model SweetWave.Web.Services.Catalog.ProductSummary
@{
    string photoPath = string.IsNullOrWhiteSpace(Model.Photo) ? "/images/placeholder.svg" : $"/images/{Model.Photo}";
}
<div class="col">
    <div class="card h-100 shadow-sm">
        <img src="@photoPath" class="card-img-top product-photo" alt="@Model.Name" />
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <span class="badge bg-light text-dark border">@Model.Category</span>
                @if (Model.IsTemperatureSensitive)
                {
                    <span class="badge bg-warning text-dark" title="Шоколад и другие чувствительные к морозу и жаре товары">боится мороза и жары</span>
                }
            </div>
            <h5 class="card-title mt-2 mb-1">@Model.Name</h5>
            <p class="text-secondary small mb-1">@Model.Manufacturer</p>
            <p class="small mb-2">@Model.WeightGrams.FormatWeight() · срок годности @Model.ShelfLifeDays дн.</p>
            <p class="card-text small flex-grow-1">@Model.Description</p>
            <div class="d-flex justify-content-between align-items-center mt-3 gap-2">
                <span class="fw-semibold">@Model.Price.FormatPrice()</span>
                <form method="post" asp-page="/Catalog" asp-page-handler="AddToCart" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="number" name="quantity" value="1" min="1" max="50"
                           class="form-control form-control-sm cart-quantity" aria-label="Количество" />
                    <button type="submit" class="btn btn-primary btn-sm">В корзину</button>
                </form>
            </div>
        </div>
    </div>
</div>