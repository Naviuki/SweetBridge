@page
@model CatalogModel
@{
    ViewData["Title"] = "Каталог";
}

<h1 class="h3 mb-3">Каталог кондитерских изделий</h1>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.Direction == ShippingDirection.YakutiaToDonbass ? "active" : string.Empty)"
           asp-page="/Catalog"
           asp-route-direction="@ShippingDirection.YakutiaToDonbass"
           asp-route-category="@Model.Category"
           asp-route-searchText="@Model.SearchText">Сладости Якутии</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Direction == ShippingDirection.DonbassToYakutia ? "active" : string.Empty)"
           asp-page="/Catalog"
           asp-route-direction="@ShippingDirection.DonbassToYakutia"
           asp-route-category="@Model.Category"
           asp-route-searchText="@Model.SearchText">Сладости Донбасса</a>
    </li>
</ul>

<form method="get" asp-page="/Catalog" class="row g-2 align-items-end mb-4">
    <input type="hidden" name="direction" value="@Model.Direction" />
    <div class="col-sm-4">
        <label class="form-label" for="category">Категория</label>
        <select class="form-select" id="category" name="category">
            <option value="">Все категории</option>
            @foreach (string category in Model.Categories)
            {
                <option value="@category" selected="@(string.Equals(category, Model.Category, StringComparison.Ordinal))">@category</option>
            }
        </select>
    </div>
    <div class="col-sm-5">
        <label class="form-label" for="searchText">Поиск по названию</label>
        <input class="form-control" id="searchText" name="searchText" value="@Model.SearchText" placeholder="Например, шоколад" />
    </div>
    <div class="col-sm-3">
        <button type="submit" class="btn btn-primary w-100">Показать</button>
    </div>
</form>

@if (Model.Products.Count == 0)
{
    <div class="alert alert-info">По вашему запросу ничего не нашлось. Попробуйте изменить фильтр.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (ProductSummary product in Model.Products)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
}