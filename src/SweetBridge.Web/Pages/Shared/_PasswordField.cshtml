@model SweetBridge.Web.Services.Account.PasswordFieldViewModel
@{
    // Поля пароля в форме: одна кнопка «Показать/Скрыть» управляет всеми полями группы.
    string? describedBy = string.IsNullOrEmpty(Model.Hint) ? null : Model.Id + "-hint";
}
<div class="field field--password">
    <label class="field__label" for="@Model.Id">@Model.Label</label>
    <input class="field__control"
           id="@Model.Id"
           name="@Model.Name"
           type="password"
           autocomplete="@Model.Autocomplete"
           required
           data-password-field
           data-field-control
           aria-describedby="@describedBy" />
    <button class="field__reveal" type="button"
            data-password-reveal
            aria-controls="@Model.Group"
            aria-pressed="false">Показать</button>
    @if (!string.IsNullOrEmpty(Model.Hint))
    {
        <span class="field__hint" id="@(Model.Id)-hint">@Model.Hint</span>
    }
</div>