@model SweetBridge.Web.Services.Account.PasswordFieldViewModel
@{
    // Ошибки поля берём из ModelState по имени поля: отдельный asp-validation-for на странице не нужен.
    var errors = ViewContext.ViewData.ModelState.TryGetValue(Model.Name, out var entry)
        ? entry.Errors.Select(error => error.ErrorMessage).Where(text => !string.IsNullOrWhiteSpace(text)).Distinct().ToList()
        : new List<string>();

    bool hasErrors = errors.Count > 0;
    string hintId = Model.Id + "-hint";
    string errorId = Model.Id + "-error";
    string describedBy = string.Join(
        " ",
        new[] { string.IsNullOrEmpty(Model.Hint) ? null : hintId, hasErrors ? errorId : null }.Where(id => id is not null));
}
<div class="field field--password @(hasErrors ? "field--invalid" : string.Empty)">
    <label class="field__label" for="@Model.Id">@Model.Label</label>
    <div class="field__wrap">
        <input class="field__control"
               id="@Model.Id"
               name="@Model.Name"
               type="password"
               autocomplete="@Model.Autocomplete"
               required
               data-password-field
               data-field-control
               aria-invalid="@(hasErrors ? "true" : "false")"
               aria-describedby="@(describedBy.Length == 0 ? null : describedBy)" />
        <button class="field__reveal" type="button"
                data-password-reveal
                aria-controls="@Model.Id"
                aria-pressed="false">Показать</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.Hint))
    {
        <span class="field__hint" id="@hintId">@Model.Hint</span>
    }
    @if (hasErrors)
    {
        <span class="field__error" id="@errorId" role="alert">@string.Join(" ", errors)</span>
    }
</div>