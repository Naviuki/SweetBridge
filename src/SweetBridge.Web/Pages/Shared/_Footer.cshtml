@using SweetBridge.Web.Extensions
@using SweetBridge.Web.Options
@inject Microsoft.Extensions.Options.IOptions<ContactsOptions> ContactsOptions
@{
    var contacts = ContactsOptions.Value;
}
<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <div>
                <span class="brand__text footer-brand">Сладкий мост<span class="brand__tagline footer-tagline">Мост к сладкому</span></span>
                <p class="footer-lead">
                    Межрегиональный маркетплейс кондитерских изделий между Якутией и Донбассом.
                </p>
                <div class="footer-social">
                    <a class="icon-button" href="https://t.me/sweetbridge" rel="noopener noreferrer nofollow" target="_blank" aria-label="Telegram">
                        @IconRenderer.Render("telegram")
                    </a>
                    <a class="icon-button" href="https://go.mail.ru/" rel="noopener noreferrer nofollow" target="_blank" aria-label="Mail.ru">
                        @IconRenderer.Render("mail")
                    </a>
                    <a class="icon-button" href="mailto:@contacts.Email" aria-label="Написать на почту">
                        @IconRenderer.Render("mail")
                    </a>
                </div>
            </div>

            <div>
                <h2 class="site-footer__title">Каталог</h2>
                <ul class="site-footer__list">
                    <li><a asp-page="/Catalog/Index" asp-route-region="@Domain.Enums.ShippingDirection.YakutiaToDonbass">Сладости Якутии</a></li>
                    <li><a asp-page="/Catalog/Index" asp-route-region="@Domain.Enums.ShippingDirection.DonbassToYakutia">Сладости Донбасса</a></li>
                    <li><a asp-page="/Gifts/Index">Подарочные наборы</a></li>
                    <li><a asp-page="/Corporate/Index">Корпоративные заказы</a></li>
                    <li><a asp-page="/Catalog/Index">Все товары</a></li>
                </ul>
            </div>

            <div>
                <h2 class="site-footer__title">Помощь</h2>
                <ul class="site-footer__list">
                    <li><a asp-page="/Info/Article" asp-route-slug="how-it-works">Как работает «волна»</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="delivery">Доставка и сроки</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="payment">Оплата</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="faq">Частые вопросы</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="returns">Возврат и обмен</a></li>
                </ul>
            </div>

            <div>
                <h2 class="site-footer__title">О проекте</h2>
                <ul class="site-footer__list">
                    <li><a asp-page="/Info/Article" asp-route-slug="about">О «Сладком мосте»</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="producers">Производители</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="partners">Партнёрам</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="hackathon">Хакатон «PEAK IT»</a></li>
                    <li><a asp-page="/Info/Article" asp-route-slug="press-kit">Пресс-кит</a></li>
                </ul>
            </div>

            <div>
                <h2 class="site-footer__title">Контакты</h2>
                <ul class="site-footer__list">
                    <li><a href="mailto:@contacts.Email">@contacts.Email</a></li>
                    <li><a href="tel:@contacts.Phone">@contacts.Phone</a></li>
                    <li>@contacts.Address</li>
                    <li>@contacts.Hours</li>
                </ul>
                <p class="footer-subscribe-title">Узнавайте о новых волнах первыми</p>
                <p class="footer-subscribe-note">Раз в 2 недели — без спама</p>
                <form method="post" asp-page="/Newsletter/Subscribe" class="subscribe">
                    <label class="visually-hidden" for="footerSubscribeEmail">Электронная почта для подписки</label>
                    <input id="footerSubscribeEmail" type="email" name="Email" placeholder="Ваш e-mail" required />
                    <button class="btn btn--primary btn--sm" type="submit">Подписаться</button>
                </form>
            </div>
        </div>

        <div class="site-footer__bottom">
            <span>© 2026 Сладкий мост · Корпорация развития Республики Саха (Якутия)</span>
            <span class="footer-links">
                <a asp-page="/Info/Article" asp-route-slug="privacy">Политика конфиденциальности</a>
                <a asp-page="/Info/Article" asp-route-slug="terms">Пользовательское соглашение</a>
                <a asp-page="/Info/Article" asp-route-slug="cookies">Cookies</a>
            </span>
        </div>
    </div>
</footer>