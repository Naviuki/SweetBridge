@using SweetBridge.Web.Extensions
@model IReadOnlyList<(string Url, string Title)>
@{
    string current = (ViewContext.RouteData.Values["page"] as string ?? string.Empty).TrimStart('/');
}
<nav class="card account-nav" aria-label="Личный кабинет">
    @foreach ((string url, string title) in Model)
    {
        bool active = string.Equals(current, url.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
        <a href="@url" class="@(active ? "is-active" : string.Empty)" aria-current="@(active ? "page" : null)">
            @IconRenderer.Render(title switch
            {
                "Мои заказы" => "box",
                "Уведомления" => "bell",
                "Избранное" => "heart",
                _ => "user"
            })
            @title
        </a>
    }
    <a asp-page="/Index">
        @IconRenderer.Render("cart")
        Продолжить покупки
    </a>
</nav>