@page
@model SweetBridge.Web.Pages.Admin.Orders.IndexModel
@using SweetBridge.Web.Extensions
@using SweetBridge.Web.Domain.Enums
@{
    ViewData["Title"] = "Заказы";
}
<section class="page">
    <div class="admin-layout">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <h1 class="page__title">Заказы</h1>

            <form class="card card-pad admin-toolbar" method="get">
                <label class="field">
                    <span class="field__label">Статус</span>
                    <select class="field__control" name="status">
                        @foreach (SweetBridge.Web.Pages.Admin.Orders.IndexModel.SelectItem item in Model.Statuses)
                        {
                            <option value="@item.Value" selected="@(Model.Status == item.Value)">@item.Title</option>
                        }
                    </select>
                </label>

                <label class="field">
                    <span class="field__label">Номер заказа</span>
                    <input class="field__control" name="search" value="@Model.Search" placeholder="SW-XXXXXX" />
                </label>

                <button class="btn btn--primary" type="submit">Фильтр</button>
            </form>

            @if (Model.Orders.Count == 0)
            {
                <div class="empty">
                    @IconRenderer.Render("box")
                    <h2>Заказов нет</h2>
                    <p class="muted">Измените фильтр или дождитесь первого заказа с витрины.</p>
                </div>
            }
            else
            {
                <div class="card card-pad">
                    <div class="table-scroll">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Номер</th>
                                    <th>Получатель</th>
                                    <th>Волна</th>
                                    <th>Статус</th>
                                    <th>Оплата</th>
                                    <th class="text-end">Сумма</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (SweetBridge.Web.Services.Orders.OrderSummary order in Model.Orders)
                                {
                                    <tr>
                                        <td class="nowrap">
                                            <a asp-page="/Orders/Details" asp-route-number="@order.Number">@order.Number</a>
                                        </td>
                                        <td>
                                            @order.RecipientName
                                            <span class="muted">· @order.RecipientCity</span>
                                            @if (order.IsGift)
                                            {
                                                <span class="chip">подарок</span>
                                            }
                                        </td>
                                        <td class="nowrap">№@order.WaveNumber · @order.WaveShipDate.FormatDate()</td>
                                        <td><span class="chip">@order.Status.ToDisplayTitle()</span></td>
                                        <td>
                                            <span class="chip @(order.PaymentStatus == PaymentStatus.Paid ? "chip--success" : "chip--muted")">
                                                @order.PaymentStatus.ToDisplayName()
                                            </span>
                                        </td>
                                        <td class="text-end nowrap">@order.Total.FormatPrice()</td>
                                        <td>
                                            <div class="row gap-6">
                                                <form method="post" asp-page-handler="Advance">
                                                    <input type="hidden" name="id" value="@order.Id" />
                                                    <button class="btn btn--outline btn--sm" type="submit"
                                                            title="Перевести на следующий статус">
                                                        @IconRenderer.Render("check")
                                                    </button>
                                                </form>
                                                @if (order.Status is not (OrderStatus.Cancelled or OrderStatus.Received))
                                                {
                                                    <form method="post" asp-page-handler="Cancel">
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <button class="btn btn--ghost btn--sm" type="submit" title="Отменить заказ">
                                                            @IconRenderer.Render("trash")
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</section>