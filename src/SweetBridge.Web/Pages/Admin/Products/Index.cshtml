@page
@model IndexModel
@{
    ViewData["Title"] = "Товары";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Товары</h1>
    <a class="btn btn-primary" asp-page="/Admin/Products/Create">Добавить товар</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Наименование</th>
                <th>Витрина</th>
                <th>Категория</th>
                <th class="text-end">Вес</th>
                <th class="text-end">Цена</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (ProductSummary product in Model.Products)
            {
                <tr class="@(product.IsActive ? string.Empty : "table-secondary")">
                    <td class="text-nowrap">@product.Id</td>
                    <td>
                        <div class="fw-semibold">@product.Name</div>
                        <div class="small text-secondary">@product.Manufacturer</div>
                    </td>
                    <td>@product.ShippingDirection.ToShortName()</td>
                    <td>@product.Category</td>
                    <td class="text-end">@product.WeightGrams.FormatWeight()</td>
                    <td class="text-end">@product.Price.FormatPrice()</td>
                    <td>
                        @if (product.IsActive)
                        {
                            <span class="badge bg-success text-white">в каталоге</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white">скрыт</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Products/Edit" asp-route-id="@product.Id">Изменить</a>
                        <form method="post" asp-page-handler="Visibility" class="d-inline">
                            <input type="hidden" name="id" value="@product.Id" />
                            <input type="hidden" name="isVisible" value="@((!product.IsActive).ToString().ToLowerInvariant())" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">
                                @(product.IsActive ? "Скрыть" : "Показать")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>