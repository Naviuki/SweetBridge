@page
@model SweetBridge.Web.Pages.Admin.Waves.IndexModel
@using SweetBridge.Web.Extensions
@using SweetBridge.Web.Domain.Enums
@using SweetBridge.Web.Services.Waves
@{
    ViewData["Title"] = "Волны";
}
<section class="page">
    <div class="admin-layout">
        <partial name="_AdminNav" />

        <div class="admin-content">
            <h1 class="page__title">Волны доставки</h1>

            <form class="card card-pad admin-toolbar" method="post" asp-page-handler="Create">
                <label class="field">
                    <span class="field__label">Дата отправки</span>
                    <input class="field__control" asp-for="ShipDate" type="date" data-field-control />
                </label>

                <label class="field">
                    <span class="field__label">Направление</span>
                    <select class="field__control" asp-for="Direction" data-field-control>
                        <option value="@ShippingDirection.YakutiaToDonbass">Якутия → ДНР</option>
                        <option value="@ShippingDirection.DonbassToYakutia">ДНР → Якутия</option>
                    </select>
                </label>

                <button class="btn btn--primary" type="submit">@IconRenderer.Render("plus") Создать волну</button>
                <p class="muted">Дедлайн приёма заказов и вместимость считаются по логистическим настройкам.</p>
            </form>

            <div class="card card-pad">
                <div class="table-scroll">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Волна</th>
                                <th>Направление</th>
                                <th>Отправка</th>
                                <th>Приём до</th>
                                <th>Заполнено</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (WaveSummary wave in Model.Waves)
                            {
                                <tr>
                                    <td>№@wave.Number</td>
                                    <td>@wave.Direction.ToShortName()</td>
                                    <td class="nowrap">@wave.ShipDate.FormatDate()</td>
                                    <td class="nowrap">@wave.OrderCutoffDate.FormatDate()</td>
                                    <td>
                                        <div class="progress" id="wave-@wave.Id" data-progress
                                             data-progress-max="100" data-progress-value="@wave.FillPercent">
                                            <span class="progress__value" data-progress-fill></span>
                                        </div>
                                        <span class="muted">
                                            @wave.FillPercent.FormatPercent() · @wave.LoadedGrams.FormatWeight()
                                            из @wave.CapacityGrams.FormatWeight()
                                        </span>
                                    </td>
                                    <td>
                                        <span class="chip">@wave.Status.ToDisplayName()</span>
                                    </td>
                                    <td>
                                        @if (wave.Status == WaveStatus.Planned)
                                        {
                                            <form method="post" asp-page-handler="Dispatch">
                                                <input type="hidden" name="id" value="@wave.Id" />
                                                <button class="btn btn--outline btn--sm" type="submit"
                                                        disabled="@(!wave.IsReadyToDispatch)"
                                                        title="@(wave.IsReadyToDispatch ? "Отправить волну" : "Набрана недостаточная загрузка")">
                                                    @IconRenderer.Render("truck")
                                                    Отправить
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>