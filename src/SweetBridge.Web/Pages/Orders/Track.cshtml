@page
@model SweetBridge.Web.Pages.Orders.TrackModel
@using SweetBridge.Web.Extensions
@using SweetBridge.Web.Domain.Enums
@{
    ViewData["Title"] = "Отследить заказ";
    ViewData["Description"] = "Отследите статус заказа по номеру и последним цифрам телефона.";
}
<section class="page">
    <h1 class="page__title">Отследить заказ</h1>
    <p class="page__lead">Введите номер заказа и телефон покупателя или получателя — покажем, на каком этапе посылка.</p>

    <div class="checkout-layout mt-16">
        <form class="card checkout-form" method="post">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>

            <label class="field">
                <span class="field__label">Номер заказа</span>
                <input class="field__control" asp-for="Number" data-field-control placeholder="SW-XXXXXX" autocomplete="off" />
                <span class="field__hint">Номер из письма о заказе или из личного кабинета</span>
            </label>

            <label class="field">
                <span class="field__label">Телефон</span>
                <input class="field__control" asp-for="Phone" data-field-control inputmode="tel"
                       autocomplete="tel" placeholder="+7 999 000-11-22" />
            </label>

            <button class="btn btn--primary" type="submit">@IconRenderer.Render("search") Найти заказ</button>
            <a class="btn btn--ghost" asp-page="/Support/Index">Не нашли? Напишите в поддержку</a>
        </form>

        <aside class="card card-pad">
            @if (Model.Order is not null)
            {
                <h2>Заказ @Model.Order.Number</h2>
                <p class="muted">
                    @IconRenderer.Render("truck")
                    Волна №@Model.Order.WaveNumber · отправка @Model.Order.WaveShipDate.ToString("dd.MM.yyyy")
                </p>
                <partial name="_OrderTracker" model="Model.Order.ToTracker()" />
                <a class="btn btn--primary btn--block mt-16" asp-page="/Orders/Details" asp-route-number="@Model.Order.Number">
                    Подробнее о заказе
                </a>
            }
            else if (Model.IsSearched)
            {
                <div class="empty">
                    @IconRenderer.Render("search")
                    <h2>Заказ не найден</h2>
                    <p class="muted">Проверьте номер и телефон. Номер выглядит как SW-XXXXXX.</p>
                    <a class="btn btn--outline" asp-page="/Support/Index">Написать в поддержку</a>
                </div>
            }
            else
            {
                <h2>Что покажет трекер</h2>
                <ul class="site-footer__list">
                    <li>Статус и дату каждого этапа</li>
                    <li>Состав заказа и стоимость</li>
                    <li>Срок доставки по вашей волне</li>
                </ul>
            }
        </aside>
    </div>
</section>