@page "{number?}"
@model SweetBridge.Web.Pages.Orders.ConfirmationModel
@using SweetBridge.Web.Extensions
@using SweetBridge.Web.Domain.Enums
@{
    var order = Model.Order!;
    ViewData["Title"] = $"Заказ {order.Number}";
}
<section class="page">
    <div class="flash flash--success" role="status">
        @IconRenderer.Render("check")
        Заказ @order.Number принят и зарезервирован в волне №@order.WaveNumber.
    </div>

    <div class="checkout-layout mt-16">
        <div class="stack gap-16">
            <div class="card card-pad">
                <div class="row row--between">
                    <h1 class="page__title">Заказ @order.Number</h1>
                    @{
                        string statusClass = order.Status switch
                        {
                            OrderStatus.Cancelled => "chip--muted",
                            OrderStatus.Received => "chip--success",
                            OrderStatus.InTransit or OrderStatus.ReadyForPickup => "chip--yakutia",
                            _ => "chip--accent"
                        };
                    }
                    <span class="chip @statusClass">@order.Status.ToDisplayName()</span>
                </div>

                <partial name="_OrderTracker" model="order.ToTracker()" />

                <div class="table-scroll">
                <table class="table table--compact mt-16">
                    <tbody>
                        <tr><th>Волна</th><td>№@order.WaveNumber, отправка @order.WaveShipDate.ToString("dd.MM.yyyy")</td></tr>
                        <tr><th>Получатель</th><td>@order.RecipientName, @order.RecipientCity</td></tr>
                        <tr><th>Пункт выдачи</th><td>@(order.RecipientPickupPoint ?? "не указан")</td></tr>
                        <tr><th>Оплата</th><td>@order.PaymentStatus.ToDisplayName()</td></tr>
                        @if (order.IsGift)
                        {
                            <tr><th>Открытка</th><td>@(order.GiftMessage ?? "без текста")</td></tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>

            <div class="card card-pad">
                <h2>Состав заказа</h2>
                <div class="table-scroll">
                <table class="table mt-8">
                    <thead>
                        <tr><th>Товар</th><th class="text-end">Кол-во</th><th class="text-end">Цена</th><th class="text-end">Сумма</th></tr>
                    </thead>
                    <tbody>
                        @foreach (SweetBridge.Web.Services.Orders.OrderLineSummary line in order.Items)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td class="text-end">@line.Quantity</td>
                                <td class="text-end">@line.UnitPrice.FormatPrice()</td>
                                <td class="text-end">@line.LineTotal.FormatPrice()</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                <dl class="summary-list mt-16">
                    <div class="summary-row"><dt>Товары</dt><dd>@order.GoodsCost.FormatPrice()</dd></div>
                    @if (order.DiscountAmount > 0m)
                    {
                        <div class="summary-row"><dt>Скидка@(string.IsNullOrWhiteSpace(order.PromoCode) ? string.Empty : $" ({order.PromoCode})")</dt><dd class="text-success">−@order.DiscountAmount.FormatPrice()</dd></div>
                    }
                    <div class="summary-row"><dt>Доставка</dt><dd>@order.ShippingCost.FormatPrice()</dd></div>
                    <div class="summary-row"><dt>Термоупаковка</dt><dd>@order.ThermoPackCost.FormatPrice()</dd></div>
                    @if (order.FillDiscountPercent > 0m)
                    {
                        <div class="summary-row"><dt>Скидка за заполнение волны</dt><dd>@((int)order.FillDiscountPercent)%</dd></div>
                    }
                    <div class="summary-total"><span>Итого</span><span>@order.Total.FormatPrice()</span></div>
                </dl>
            </div>
        </div>

        <aside class="card cart-summary">
            @if (order.PaymentStatus == PaymentStatus.Pending)
            {
                <h2>Оплата</h2>
                <p class="muted">
                    Вес зарезервирован в волне до @order.PaymentDueAtUtc?.ToString("HH:mm") UTC.
                    После этого резерв снимется.
                </p>
                <a class="btn btn--primary btn--block" asp-page="/Checkout/Pay" asp-route-number="@order.Number">
                    Оплатить @order.Total.FormatPrice()
                </a>
            }
            else
            {
                <h2>Оплата</h2>
                <div class="flash flash--success" role="status">@IconRenderer.Render("check") Заказ оплачен</div>
            }

            <a class="btn btn--outline btn--block" asp-page="/Orders/Confirmation" asp-route-number="@order.Number" asp-page-handler="Receipt">
                @IconRenderer.Render("download")
                Скачать накладную (PDF)
            </a>
            <a class="btn btn--ghost btn--block" asp-page="/Orders/Details" asp-route-number="@order.Number">Карточка заказа</a>
            <a class="btn btn--ghost btn--block" asp-page="/Catalog/Index">Продолжить покупки</a>
        </aside>
    </div>
</section>