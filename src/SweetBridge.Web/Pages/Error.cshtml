@page
@model ErrorModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="text-center py-5">
    <h1 class="display-5">Страница не найдена</h1>
    <p class="lead">
        @(Model.ShowRequestId
            ? $"Запрошенная страница недоступна. Идентификатор запроса: {Model.RequestId}"
            : "Запрошенная страница недоступна или была перемещена.")
    </p>
    <a class="btn btn-primary" asp-page="/Index">На главную</a>
    <a class="btn btn-outline-primary" asp-page="/Catalog">В каталог</a>
</div>