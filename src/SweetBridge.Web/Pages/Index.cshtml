@page
@model SweetBridge.Web.Pages.IndexModel
@using SweetBridge.Web.Domain.Enums
@using SweetBridge.Web.Extensions
@using SweetBridge.Web.Services.Waves
@{
    ViewData["Title"] = "Сладкий мост";
    ViewData["Description"] = "Сладкий мост — маркетплейс кондитерских изделий между Якутией и Донбассом. Доставка сборными волнами, промокоды и подарочные наборы.";
}
<section class="hero">
    <div>
        <span class="chip chip--accent">Маркетплейс Якутии и Донбасса</span>
        <h1 class="hero__title">Сладкий мост: волны сладостей между Якутией и ДНР</h1>
        <p class="hero__lead">
            Сладости местных производителей едут друг к другу сборными волнами раз в две недели.
            Вы выбираете товар и волну — мы собираем посылку, возим её и выдаём в пункте выдачи.
            Чем больше заказов в волне, тем ниже стоимость доставки.
        </p>
        <div class="row gap-12">
            <a class="btn btn--primary" asp-page="/Catalog/Index" asp-route-region="@ShippingDirection.YakutiaToDonbass">
                Сладости Якутии
            </a>
            <a class="btn btn--secondary" asp-page="/Catalog/Index" asp-route-region="@ShippingDirection.DonbassToYakutia">
                Сладости Донбасса
            </a>
            <a class="btn btn--ghost" asp-page="/Orders/Track">Отследить заказ</a>
        </div>
    </div>

    <div class="hero__tiles">
        <a class="hero__tile hero__tile--yakutia" asp-page="/Catalog/Index" asp-route-region="@ShippingDirection.YakutiaToDonbass">
            @IconRenderer.Render("snowflake")
            <strong>Витрина Якутии</strong>
            <span class="muted">Шоколад, ореховые конфеты, зефир, молочная пастила</span>
        </a>
        <a class="hero__tile hero__tile--donbass" asp-page="/Catalog/Index" asp-route-region="@ShippingDirection.DonbassToYakutia">
            @IconRenderer.Render("sun")
            <strong>Витрина ДНР</strong>
            <span class="muted">Пряники, карамель, «Доннари», вафли и зеркальные торты</span>
        </a>
        <a class="hero__tile" asp-page="/Gifts/Index">
            @IconRenderer.Render("gift")
            <strong>Подарочные наборы</strong>
            <span class="muted">Готовые подборки с открыткой и без выбора состава</span>
        </a>
    </div>
</section>

<section class="section">
    <div class="section__head">
        <h2>Ближайшие волны</h2>
        <a class="btn btn--ghost btn--sm" asp-page="/Info/HowItWorks">Как это работает</a>
    </div>
    <div class="grid grid--2">
        @{
            var allWaves = Model.WavesToDonbass.Concat(Model.WavesToYakutia).Take(4).ToList();
        }
        @foreach (SweetBridge.Web.Services.Waves.WaveSummary wave in allWaves)
        {
            <partial name="_WaveCard" model="wave" />
        }
    </div></section>

<section class="section">
    <div class="section__head">
        <h2>Сладости Якутии</h2>
        <a class="btn btn--ghost btn--sm" asp-page="/Catalog/Index" asp-route-region="@ShippingDirection.YakutiaToDonbass">Весь каталог</a>
    </div>
    <div class="product-grid">
        @foreach (SweetBridge.Web.Services.Catalog.ProductCardViewModel product in Model.YakutiaShowcase)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>

<section class="section">
    <div class="section__head">
        <h2>Сладости Донбасса</h2>
        <a class="btn btn--ghost btn--sm" asp-page="/Catalog/Index" asp-route-region="@ShippingDirection.DonbassToYakutia">Весь каталог</a>
    </div>
    <div class="product-grid">
        @foreach (SweetBridge.Web.Services.Catalog.ProductCardViewModel product in Model.DonbassShowcase)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>

<section class="section">
    <div class="section__head"><h2>Как работает «волна»</h2></div>
    <div class="grid grid--4">
        <article class="card card--flat step-card">
            <span class="step-card__number">1</span>
            @IconRenderer.Render("cart")
            <strong>Выбираете</strong>
            <span class="muted">Сладости одной витрины и удобную волну.</span>
        </article>
        <article class="card card--flat step-card">
            <span class="step-card__number">2</span>
            @IconRenderer.Render("ticket")
            <strong>Оформляете</strong>
            <span class="muted">Доставку в свой город или подарок близкому человеку.</span>
        </article>
        <article class="card card--flat step-card">
            <span class="step-card__number">3</span>
            @IconRenderer.Render("wave")
            <strong>Мы собираем</strong>
            <span class="muted">Волна набирается, пока не достигнет нужного веса.</span>
        </article>
        <article class="card card--flat step-card">
            <span class="step-card__number">4</span>
            @IconRenderer.Render("map")
            <strong>Вы забираете</strong>
            <span class="muted">Заказ ждёт в пункте выдачи 5 дней.</span>
        </article>
    </div>
</section>