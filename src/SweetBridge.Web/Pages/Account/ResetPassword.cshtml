@page
@model SweetBridge.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Новый пароль";
}
<section class="page">
    <div class="card auth-card card-pad">
        <h1 class="page__title">Новый пароль</h1>
        <p class="page__lead">Придумайте новый пароль для аккаунта.</p>

        <form method="post" class="mt-16">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>
            <input type="hidden" asp-for="Input.Code" />

            <label class="field">
                <span class="field__label">Электронная почта</span>
                <input class="field__control" asp-for="Input.Email" data-field-control type="email" autocomplete="username" />
                <span class="field__error" asp-validation-for="Input.Email"></span>
            </label>

            <label class="field">
                <span class="field__label">Новый пароль</span>
                <input class="field__control" asp-for="Input.Password" data-field-control autocomplete="new-password" />
                <span class="field__error" asp-validation-for="Input.Password"></span>
            </label>

            <label class="field">
                <span class="field__label">Повторите новый пароль</span>
                <input class="field__control" asp-for="Input.ConfirmPassword" data-field-control autocomplete="new-password" />
                <span class="field__error" asp-validation-for="Input.ConfirmPassword"></span>
            </label>

            <button class="btn btn--primary btn--block" type="submit">Сохранить пароль</button>
        </form>
    </div>
</section>