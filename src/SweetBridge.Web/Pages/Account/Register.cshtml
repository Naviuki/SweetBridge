@page
@model SweetBridge.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}
<section class="page">
    <div class="card auth-card card-pad">
        <h1 class="page__title">Регистрация</h1>
        <p class="page__lead">Аккаунт нужен, чтобы следить за заказами и хранить избранное.</p>

        <form method="post" class="mt-16" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-errors" role="alert"></div>

            <label class="field">
                <span class="field__label">Имя и фамилия</span>
                <input class="field__control" asp-for="Input.Name" data-field-control autocomplete="name"
                       maxlength="200" required data-val-required-message="Заполните это поле." aria-describedby="name-error" autofocus />
                <span class="field__error" id="name-error" asp-validation-for="Input.Name"></span>
            </label>

            <label class="field">
                <span class="field__label">Электронная почта</span>
                <input class="field__control" asp-for="Input.Email" data-field-control type="email"
                       autocomplete="email" inputmode="email" maxlength="320" required data-val-required-message="Заполните это поле." aria-describedby="email-error" />
                <span class="field__error" id="email-error" asp-validation-for="Input.Email"></span>
            </label>

            <label class="field">
                <span class="field__label">Телефон</span>
                <input class="field__control" asp-for="Input.Phone" data-field-control type="tel"
                       autocomplete="tel" inputmode="tel" maxlength="40" required
                       placeholder="+7 999 000-11-22" aria-describedby="phone-hint phone-error" />
                <span class="field__hint" id="phone-hint">Нужен для связи при доставке</span>
                <span class="field__error" id="phone-error" asp-validation-for="Input.Phone"></span>
            </label>

            <partial name="_PasswordField" model="Model.NewPasswordField" />

            <partial name="_PasswordField" model="Model.ConfirmPasswordField" />

            <span class="field__error" asp-validation-for="Input.ConfirmPassword"></span>

            <button class="btn btn--primary btn--block" type="submit">Создать аккаунт</button>
        </form>

        <p class="mt-16">Уже есть аккаунт? <a asp-page="/Account/Login">Войти</a></p>
    </div>
</section>