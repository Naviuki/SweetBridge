@page
@model SweetBridge.Web.Pages.Account.ForgotPasswordModel
@using SweetBridge.Web.Extensions
@{
    ViewData["Title"] = "Смена пароля";
}
<section class="page">
    <div class="card auth-card card-pad">
        <h1 class="page__title">Смена пароля</h1>
        <p class="page__lead">Укажите почту — пришлём ссылку для создания нового пароля.</p>

        <form method="post" class="mt-16">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>

            <label class="field">
                <span class="field__label">Электронная почта</span>
                <input class="field__control" asp-for="Email" data-field-control type="email" autocomplete="username" autofocus />
                <span class="field__error" asp-validation-for="Email"></span>
            </label>

            <button class="btn btn--primary btn--block" type="submit">@IconRenderer.Render("mail") Отправить письмо</button>
        </form>

        <p class="mt-16"><a asp-page="/Account/Login">Вернуться ко входу</a></p>
    </div>
</section>