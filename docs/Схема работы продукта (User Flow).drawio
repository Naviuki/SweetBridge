          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gE7" value="да" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;fontSize=11;" edge="1" parent="gLaneUser" source="gDecFields" target="gWaves">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gE8" value="исправить" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="gLaneUser" source="gErr" target="gFields">
