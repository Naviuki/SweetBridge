          <mxGeometry x="70" y="735" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bDec3" value="Это подарок?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="110" y="835" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bGift" value="Данные получателя и текст открытки&#10;подробно на странице 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;fontSize=10;dashed=1;" vertex="1" parent="bLaneUser">
          <mxGeometry x="310" y="850" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bWaves" value="Выбор волны: таблица открытых волн с расчётом доставки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="70" y="960" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bDec4" value="Волна открыта и есть свободное место?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="110" y="1050" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bErr2" value="Волна закрыта или заполнена: выбрать другую волну" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="310" y="1070" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bThermo" value="Термоупаковка: обязательна, если в заказе шоколад, а месяц отправки — 12, 1, 2, 6, 7 или 8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="70" y="1180" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bPay" value="Итог: товары + доставка + термоупаковка. Кнопка «Оплатить (демо)»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="70" y="1280" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="bSysOffer" value="Формирует предложения волн: заполнение, скидка, доставка, срок" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="bLaneSys">
          <mxGeometry x="70" y="960" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bSysCheck" value="Повторно проверяет волну и вместимость, пересчитывает цену по данным базы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="bLaneSys">
          <mxGeometry x="70" y="1280" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bSysOrder" value="Создаёт заказ в транзакции: номер SW-XXXXXX, позиции со снимком цен и веса" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="bLaneSys">
          <mxGeometry x="70" y="1370" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bSysTrack" value="Отслеживание по номеру заказа и телефону, таймлайн статусов" style="shape=note;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="bLaneSys">
