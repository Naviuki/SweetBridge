        <mxCell id="gE2" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;" edge="1" parent="gLaneUser" source="gPick" target="gCheckout">
