        </mxCell>
        <mxCell id="gE3" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;" edge="1" parent="gLaneUser" source="gCheckout" target="gToggle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gE4" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;" edge="1" parent="gLaneUser" source="gToggle" target="gFields">
