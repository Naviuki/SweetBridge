        </mxCell>
        <mxCell id="pB1a" value="Создать решение, веб-проект и проект тестов на .NET 8, подключить EF Core и CsvHelper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="pLaneBackend">
