  <diagram id="sweetwave-buyer" name="2. Покупатель: личный заказ">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1754" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bTitle" value="Сегмент «Покупатель»: путь от входа до получения заказа" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="760" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bLegend" value="Кто пользователь: житель Якутии или ДНР, который хочет получить сладости другого региона.&#10;&#10;Цель: оформить заказ и получить его.&#10;&#10;Ключевое правило: товары одной витрины едут в противоположный регион." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="180" height="200" as="geometry" />
        </mxCell>

        <mxCell id="bLaneUser" value="Покупатель (браузер)" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="480" height="1660" as="geometry" />
        </mxCell>
        <mxCell id="bLaneSys" value="Система SweetWave" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#f5faff;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="480" height="1660" as="geometry" />
        </mxCell>

        <mxCell id="bStart" value="Начало: покупатель открывает сайт" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="115" y="40" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bHome" value="Главная: выбор витрины — Сладости Якутии или Сладости Донбасса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="70" y="130" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bCatalog" value="Каталог: фильтр по категории, поиск по названию и производителю" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="70" y="215" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bCard" value="Карточка товара: цена, вес, срок годности, значок «боится мороза и жары»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="70" y="300" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bDec1" value="Добавить товар в корзину?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="110" y="395" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bCart" value="Корзина: изменение количества, общий вес, стоимость товаров" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="70" y="520" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bDec2" value="Все товары одной витрины?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="110" y="610" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bErr1" value="Нельзя смешивать витрины: очистить корзину или оформить текущий заказ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="bLaneUser">
          <mxGeometry x="310" y="625" width="160" height="60" as="geometry" />
