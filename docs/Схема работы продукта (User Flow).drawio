  <diagram id="sweetwave-gift" name="3. Покупатель: подарок">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="gTitle" value="Сегмент «Покупатель-даритель»: заказ подарка в другой регион" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="770" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gNote" value="Пользователь: покупатель, у которого есть получатель в другом регионе.&#10;&#10;Цель: доставить подарок с открыткой в регион получателя.&#10;&#10;Особенность: получатель всегда находится в регионе доставки, то есть в регионе, противоположном производителю." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="180" height="210" as="geometry" />
        </mxCell>

        <mxCell id="gLaneUser" value="Покупатель" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="500" height="1440" as="geometry" />
        </mxCell>
        <mxCell id="gLaneSys" value="Система и администратор" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=#f5faff;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="500" height="1440" as="geometry" />
        </mxCell>

        <mxCell id="gStart" value="Начало: покупатель хочет порадовать близкого человека" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="90" y="40" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gPick" value="Каталог: выбирает товары и добавляет их в корзину" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="80" y="130" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gCheckout" value="Оформление: имя и телефон покупателя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="80" y="220" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gToggle" value="Включает переключатель «Это подарок»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="80" y="310" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gFields" value="Появляются поля: имя и телефон получателя, город получателя, пункт выдачи, текст открытки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="80" y="400" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gDecFields" value="Получатель указан в регионе доставки?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="130" y="510" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gErr" value="Сообщение: для подарка обязательны имя и телефон получателя" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="80" y="650" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gWaves" value="Выбор волны: расчёт учитывает шоколад и месяц отправки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="80" y="750" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gPay" value="Проверяет итог и нажимает «Оплатить (демо)»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="gLaneUser">
          <mxGeometry x="80" y="840" width="270" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gSave" value="Сохраняет заказ: получатель, открытка, флаг подарка" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="gLaneSys">
          <mxGeometry x="80" y="840" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gAdmin" value="Администратор видит метку «подарок», получателя и текст открытки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="gLaneSys">
          <mxGeometry x="80" y="940" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gWaveShip" value="Отправка волны администратором: заказ переходит в статус «в пути»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="gLaneSys">
          <mxGeometry x="80" y="1050" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gPickup" value="Получатель забирает заказ в пункте выдачи" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="gLaneSys">
          <mxGeometry x="80" y="1160" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gEnd" value="Цель достигнута: подарок доставлен и получен" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="gLaneSys">
          <mxGeometry x="80" y="1270" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gE1" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;" edge="1" parent="gLaneUser" source="gStart" target="gPick">
          <mxGeometry relative="1" as="geometry" />
